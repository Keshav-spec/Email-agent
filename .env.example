# ==============================================================================
# EMAIL DEADLINE AGENT - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env' and fill in your actual credentials.
# NEVER commit your actual '.env' file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. EMAIL ACCOUNT (IMAP) SETTINGS
# ------------------------------------------------------------------------------
# Your full email address
EMAIL_ADDRESS=your_email@gmail.com

# For Gmail: Use an "App Password", NOT your personal Google Account password!
# Steps to generate:
# 1. Turn ON 2-Step Verification in Google Account Settings.
# 2. Go to: https://myaccount.google.com/apppasswords
# 3. Create a new App Password (name it "DeadlineAgent") and copy the 16-character code here.
# For Outlook / Office 365: Use an App Password from your Microsoft Account security page.
EMAIL_PASSWORD=xxxx xxxx xxxx xxxx

# IMAP Server Host
# - Gmail: imap.gmail.com
# - Outlook / Hotmail: outlook.office365.com
# - Yahoo: imap.mail.yahoo.com
# - iCloud: imap.mail.me.com
IMAP_HOST=imap.gmail.com

# IMAP Port (993 for SSL)
IMAP_PORT=993

# Use SSL/TLS encryption (True/False)
USE_SSL=True

# ------------------------------------------------------------------------------
# 2. AI PARSER SETTINGS (GOOGLE GEMINI ONLY)
# ------------------------------------------------------------------------------
# Google Gemini API Key (Get a free key from https://aistudio.google.com/)
GEMINI_API_KEY=AIzaSy...

# Google Gemini Model Name (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 3. AGENT RUNTIME BEHAVIOR
# ------------------------------------------------------------------------------
# Filter emails received TODAY only (True/False) - default: True
TODAY_ONLY=True

# Scan all emails including read ones (False) or unread only (True) - default: False
UNREAD_ONLY=False

# Approaching deadline alert notification window in minutes (default: 60 minutes)
# Agent plays Windows chime, desktop toast, and console alert ~1 hour before due time
ALERT_WINDOW_MINUTES=60

# Maximum number of emails to scan per execution
FETCH_LIMIT=50

# Mark processed emails as 'Read' on the IMAP server (True / False)
# Recommended: False (agent uses non-destructive BODY.PEEK so inbox state is untouched)
MARK_AS_READ=False

# Destination file path for generated Markdown deadline report
OUTPUT_PATH=deadlines.md

# Timezone name for relative date calculations (e.g. UTC, America/New_York, Asia/Kolkata)
TIMEZONE=UTC
